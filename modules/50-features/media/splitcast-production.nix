{inputs, ...}: {
  flake.modules.nixos.splitcast-production = {
    config,
    lib,
    ...
  }: {
    imports = [inputs.splitcast.nixosModules.default];
    config = lib.mkIf config.local.features.splitcast-production.enable {
      services.splitcast = {
        enable = true;
        role = "production";
      };
      nix.settings = import ./_internal/cache.nix;
    };
  };
  # The profile contains the unit and TOML generated by the upstream module.
  # Do not recreate its start/cleanup implementation or bypass its parity gate.
  flake.modules.homeManager.splitcast-production-profile = {
    config,
    lib,
    ...
  }: let
    profile = "${config.xdg.stateHome}/nix/profiles/splitcast-production";
  in {
    config = lib.mkIf config.local.features.splitcast-production-profile.enable {
      assertions = [{
        assertion = !config.local.features.splitcast-production.enable;
        message = "SplitCast production must have one user-unit owner (profile or embedded Home Manager).";
      }];
      home.sessionPath = ["${profile}/bin"];
      xdg.configFile."splitcast/production.toml".source =
        config.lib.file.mkOutOfStoreSymlink "${profile}/share/splitcast/production.toml";
      xdg.configFile."systemd/user/splitcast-production.service".source =
        config.lib.file.mkOutOfStoreSymlink "${profile}/share/systemd/user/splitcast-production.service";
    };
  };
  flake.modules.homeManager.splitcast-production = {
    config,
    lib,
    ...
  }: {
    imports = [inputs.splitcast.homeManagerModules.default];
    services.splitcast = lib.mkIf config.local.features.splitcast-production.enable {
      enable = true;
      role = "production";
      rustCandidate = lib.mkDefault false;
    };
  };
}
